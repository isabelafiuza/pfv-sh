{
    // Modo de execucao do modelo: train | predict    
    "mode": "train",

    // Caminho para a leitura dos dados de entrada 
    "input": "./data",

    // Caminho para a escrita dos dados de saida 
    "output": "./out",

    // Caminho para obtencao do artefato do modelo treinado 
    "artifact": "./artifact",

    // Lista dos ids de usinas a serem consideradas no processo; vazio usa todas 
    "ids_usinas": ["BAUFI1"],

    // Vetor de uma posicao contendo data como string no padrao YYY-MM-DD indicando a data referencia de execucao,
    //      * Para o modo de execucao ´predict´, corresponde a data de referencia para a qual se deseja realizar a predicao
    //      * Para o modo de execucao ´train´, corresponde a data de referencia a partir da qual serao criados os subsets dos dados para treino 
    "data_referencia": "2025-07-02",

    // Horizonte de previsao.
    //      * Para o modo de execucao ´predict´, e tratado como o horizonte de dias que sera realizada a previsao,
    //      utilizando a data informada na chave "data_referencia". 
    //      Exemplo: para "data_referencia": "2025-07-02" e "horizonte_dias": ["D+0","D+1"], sera realizada a previsao 
    //      para o horizonte de "2025-07-02", "2025-07-03".
    //      * Para o modo de execucao ´train´, e tratado como o horizonte de dias a frente para treinamento do modelo.
    "horizonte_dias": ["D+0", "D+1"],

    // Lista contendo o nome dos modelos NWP a serem considerados no processo de previsao
    "modelos_NWP": ["GFS"],

    // Modelos de previsao de geracao. 
    // Devem ser listas contendo as seguintes chaves:
    //      * "tipo" indicando um tipo de modelo suportado na aplicação: "arimax" | "fisico_estimado"
    //      * "n_dias_treino" contendo valor inteiro que representa o numero de dias utilizados para treinamento 
    //      do modelo, a serem contados a partir da data de referencia indicada na chave "data_referencia"
    "modelos_previsao": {
        "arimax": {
            "tipo": "arimax",
            "n_dias_treino": 360,
            "amos_min": 5
        },
        "fisico_estimado": {
            "tipo": "fisico_estimado",
            "n_dias_treino": 180,
            "amos_min": 5
        }
    },

    // Parametros utilizados para definicao do periodo de geracao.
    // Deve ser uma lista contendo as seguintes chaves:
    //      * "fator_tolerancia_limite_superior_geracao": Fator de tolerancia superior para eliminacao 
    //        de dados invalidos de geracao, multiplicado pela capacidade instalada da usina,
    //      * "fator_tolerancia_limite_inferior_geracao": Fator de tolerancia inferior para considerar 
    //        geracao semi-horaria significativa, multiplicado pela capacidade instalada da usina
    //      * "percentual_dias_geracao": Percentual minimo de dias com geracao acima do limite para 
    //        considerar como semi-hora com geracao
    "parametros_periodo_geracao":{
        "fator_tolerancia_limite_superior_geracao": 1.1,
        "fator_tolerancia_limite_inferior_geracao": 0.01,
        "percentual_dias_geracao": 0.9
    }
}