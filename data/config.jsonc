{
    // Modo de execucao do modelo: train | predict    
    "mode": "train",

    // Caminho para a leitura dos dados de entrada 
    "input": "./data",

    // Caminho para a escrita dos dados de saida 
    "output": "./out",

    // Caminho para obtencao do artefato do modelo treinado 
    "artifact": ".",

    // Vetor dos ids de usinas a serem consideradas no processo; vazio usa todas 
    "ids_usinas": ["BAUFI1"],

    // Vetor de uma posicao contendo data como string no padrao YYY-MM-DD indicando a data referencia de execucao,
    // Para o modo de execucao ´predict´, corresponde a data de referencia para a qual se deseja realizar a predicao
    // Para o modo de execucao ´train´, corresponde a data de referencia a partir da qual serao criados os subsets dos dados para treino 
    "data_referencia": "2025-07-02",

    // Quantidade de dias do horizonte de previsao.
    //      * Para o modo de execucao ´predict´, e tratado como o horizonte de dias sera realizada a previsao,
    //      utilizando a data informada na chave "data_referencia". Exemplo: para "data_referencia": "2025-07-02" e 
    //      "horizonte_dias": 5, sera realizada a previsao para o horizonte de "2025-07-02", "2025-07-03", "2025-07-04",
    //      "2025-07-05", "2025-07-06".
    //      * Para o modo de execucao ´train´, e tratado como o horizonte de dias a frente para treinamento do modelo.
    "horizonte_dias": ["D+0"],

    // Vetor contendo o nome dos modelos NWP a serem considerados no processo de previsao
    "modelos_NWP": ["GFS"],

    // Modelos de previsao de geracao. Devem ser listas contendo "tipo" indicando um tipo de modelo
    // suportado na aplicação. Os elementos seguintes devem representar os argumentos...
    "modelos_previsao": {
        "arimax": {
            "tipo": "arimax"
        },
        "fisico_estimado": {
            "tipo": "fisico_estimado"
        }
    }
}